rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global top 10, one list per board "<pieces>-<background>-<shape>", e.g. "22-flag-classic".
    // Anyone can read; anyone can add one valid score; nobody can change or delete.
    match /boards/{board}/scores/{scoreId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['name', 'ms', 'pieces', 'shape', 'bg', 'date'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 20
        && request.resource.data.ms is int
        && request.resource.data.ms >= 3000
        && request.resource.data.ms < 36000000
        && request.resource.data.pieces is int
        && request.resource.data.pieces >= 2
        && request.resource.data.pieces <= 80
        && request.resource.data.shape in ['classic', 'wavy']
        && request.resource.data.bg in ['map', 'flag']
        && board == string(request.resource.data.pieces) + '-' + request.resource.data.bg + '-' + request.resource.data.shape
        && request.resource.data.date is timestamp;
      allow update, delete: if false;
    }
  }
}
